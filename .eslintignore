# Prettier is pointed at this file with --ignore-path, which REPLACES its
# default .gitignore. So anything git ignores but this file does not is still
# scanned. These are the ones that are large, generated, or not product source.
.venv
.worktrees
node_modules

# Reference material dropped into the repository root by hand. It is gitignored
# and is not product source, so the formatter must not touch it.
token-saving-harness-vscode.md

# A vendored third-party tool lives in this repository: it is copied in
# verbatim and its version stamp is computed over its file list, so a
# formatter must not touch it. Same for the tool's own task files, the
# session records it generates, and the agent briefs.
tasks
sessions
